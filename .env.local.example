# Google OAuth (Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3111/api/auth/google/callback

# Empleos (opcionales). Por defecto el dashboard lanza el scraper de ./scraper al abrirse
# y lee ./scraper/ofertas_encontradas.csv
JOBS_HOME_TOWN=            # municipio de casa: puntua la cercania
JOBS_SCRAPER_DIR=          # carpeta del scraper, si no es ./scraper
JOBS_CSV_PATH=             # CSV, si no es el del scraper
JOBS_REFRESH_HOURS=12      # horas minimas entre ejecuciones automaticas
PYTHON_BIN=                # por defecto: python (Windows) / python3
POSTULACIONES_CSV_PATH=   # CSV de postulaciones, si no es data/postulaciones.csv (Fecha,Empresa,Puesto,Link,Fase,Observaciones)
